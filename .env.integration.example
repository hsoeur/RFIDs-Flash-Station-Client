# URL de l'API Data locale. La valeur de VITE_API_DATA dans .env est utilisée par défaut.
API_DATA_BASE_URL=http://localhost:10000/api

# UID d'un ordre de fabrication présent dans la base de test et possédant
# au moins un programme de soudure actif.
TEST_MANUFACTURING_ORDER_UID=12345

# UID volontairement invalide. L'API considère les valeurs <= 0 comme invalides.
TEST_INVALID_MANUFACTURING_ORDER_UID=0
